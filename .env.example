# ==========================================
# PayTR Ödeme Entegrasyonu Ortam Değişkenleri
# ==========================================
# PayTR Mağaza Paneli (https://www.paytr.com/magaza/bilgi) üzerinden alacağınız API bilgileri:
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Test Modu: '1' test ortamı (gerçek karttan para çekilmez), '0' canlı/production ortamı
PAYTR_TEST_MODE=1

# Hata Ayıklama (Debug): '1' açık, '0' kapalı
PAYTR_DEBUG_ON=1

# iFrame Zaman Aşımı Süresi (dakika)
PAYTR_TIMEOUT_LIMIT=30

# Web Sitesi Public URL (Callback ve Redirect adresleri için)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ==========================================
# Firebase Client Konfigürasyonu
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ==========================================
# Firebase Admin SDK (Opsiyonel / Server-Side)
# ==========================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================
# HepsiJET Kargo Entegrasyonu (Server-Side)
# ==========================================
# Canlı: https://integration.hepsijet.com  |  Test: https://integration-apitest.hepsijet.com
HEPSIJET_BASE_URL=https://integration.hepsijet.com
HEPSIJET_USERNAME=
HEPSIJET_PASSWORD=

# Canlı gönderi oluşturma onayı ('true' ise gerçek kargo gönderisi oluşturulur, 'false' ise simülasyon/onay bekleme modu çalışır)
HEPSIJET_LIVE_DISPATCH_ENABLED=false

# ==========================================
# iyzico Ödeme Entegrasyonu (Server-Side)
# ==========================================
# Canlı: https://api.iyzipay.com  |  Sandbox/Test: https://sandbox-api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

